<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ivory"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingTop="56dp"
        android:paddingBottom="40dp">

        <TextView
            style="@style/Label"
            android:text="@string/reels_today" />

        <TextView
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/poppins_medium"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:text="0"
            android:textColor="@color/dark"
            android:textSize="112sp" />

        <TextView
            android:id="@+id/subtitle"
            style="@style/Body"
            android:layout_marginTop="4dp"
            android:textColor="@color/muted" />

        <app.reelcount.WeekChart
            android:id="@+id/week"
            android:layout_width="match_parent"
            android:layout_height="132dp"
            android:layout_marginTop="40dp" />

        <View
            style="@style/Divider"
            android:layout_marginTop="32dp" />

        <LinearLayout
            android:id="@+id/status_on"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="20dp">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_green" />

            <TextView
                style="@style/Body"
                android:layout_marginStart="12dp"
                android:text="@string/status_on" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/status_off"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/turn_on"
                android:textColor="@color/dark"
                android:textSize="16sp" />

            <TextView
                style="@style/Body"
                android:layout_marginTop="6dp"
                android:text="@string/setup_hint"
                android:textColor="@color/muted"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/open_a11y"
                    style="@style/Button.Primary"
                    android:text="@string/open_a11y" />

                <TextView
                    android:id="@+id/open_app_info"
                    style="@style/Button.Ghost"
                    android:layout_marginStart="8dp"
                    android:text="@string/app_info" />
            </LinearLayout>
        </LinearLayout>

        <View style="@style/Divider" />

        <TextView
            style="@style/Label"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="4dp"
            android:text="@string/settings" />

        <LinearLayout style="@style/Row">

            <TextView
                style="@style/RowTitle"
                android:text="@string/pill" />

            <LinearLayout style="@style/Segments">

                <TextView
                    android:id="@+id/seg_island"
                    style="@style/Segment"
                    android:text="@string/island" />

                <TextView
                    android:id="@+id/seg_beside"
                    style="@style/Segment"
                    android:text="@string/beside" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/Row">

            <TextView
                style="@style/RowTitle"
                android:text="@string/show" />

            <LinearLayout style="@style/Segments">

                <TextView
                    android:id="@+id/seg_facebook"
                    style="@style/Segment"
                    android:text="@string/in_facebook" />

                <TextView
                    android:id="@+id/seg_always"
                    style="@style/Segment"
                    android:text="@string/always" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/Row">

            <TextView
                style="@style/RowTitle"
                android:text="@string/daily_limit" />

            <TextView
                android:id="@+id/limit_minus"
                style="@style/Stepper"
                android:text="−" />

            <TextView
                android:id="@+id/limit_value"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:textColor="@color/dark"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/limit_plus"
                style="@style/Stepper"
                android:text="+" />
        </LinearLayout>

        <LinearLayout style="@style/Row">

            <TextView
                android:id="@+id/reset"
                style="@style/RowTitle"
                android:text="@string/reset_today"
                android:textColor="@color/orange" />
        </LinearLayout>

        <TextView
            android:id="@+id/debug"
            style="@style/Body"
            android:layout_marginTop="24dp"
            android:fontFamily="monospace"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
